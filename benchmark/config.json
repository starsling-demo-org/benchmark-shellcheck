  "adaptations": [
    {
      "id": "setgitversion-describe-fallback",
      "kind": "environment-gap",
      "workflowFile": "setgitversion",
      "fromPattern": "version=$(git describe)",
      "toReplacement": "version=$(git describe --tags --always)",
      "expectedMatches": 1,
      "reason": "The benchmark repository has no upstream tags, so `git describe` fails under `set -e` and package_source stops. Not needed if upstream tags are pushed to the benchmark repository.",
      "blocksFullParity": false
    },
    {
      "id": "no-deploy",
      "kind": "deployment-guard",
      "workflowFile": ".github/workflows/build.yml",
      "jobId": "deploy",
      "fromPattern": "github.event_name == 'push'",
      "toReplacement": "false && github.event_name == 'push'",
      "expectedMatches": 1,
      "reason": "build.yml job deploy (environment Deploy): creates GitHub releases with the token, sleeps 300 s and pushes images to Docker Hub with secrets that do not exist here. Upstream's if: kept, 'false &&' in front, so it is off in every configuration. Known parity difference: the replay does not include deploy or its 5-minute sleep",
      "blocksFullParity": true
    },
    {
      "id": "secret-gate-docker-username",
      "kind": "secret-gate-annotation",
      "workflowFile": ".github/workflows/build.yml",
      "jobId": "deploy",
      "fromPattern": "${{ secrets.DOCKER_USERNAME }}",
      "toReplacement": "",
      "expectedMatches": 2,
      "reason": "DOCKER_USERNAME does not exist in the benchmark org; only the deploy job reads it, and no-deploy turns that job off. The reference is removed so no configuration reads it.",
      "blocksFullParity": false
    },
    {
      "id": "secret-gate-docker-password",
      "kind": "secret-gate-annotation",
      "workflowFile": ".github/workflows/build.yml",
      "jobId": "deploy",
      "fromPattern": "${{ secrets.DOCKER_PASSWORD }}",
      "toReplacement": "",
      "expectedMatches": 1,
      "reason": "DOCKER_PASSWORD does not exist in the benchmark org; only the deploy job reads it, and no-deploy turns that job off. The reference is removed so no configuration reads it.",
      "blocksFullParity": false
    },
    {
      "id": "secret-gate-docker-email",
      "kind": "secret-gate-annotation",
      "workflowFile": ".github/workflows/build.yml",
      "jobId": "deploy",
      "fromPattern": "${{ secrets.DOCKER_EMAIL }}",
      "toReplacement": "",
      "expectedMatches": 1,
      "reason": "DOCKER_EMAIL does not exist in the benchmark org; only the deploy job reads it, and no-deploy turns that job off. The reference is removed so no configuration reads it.",
